<!DOCTYPE html>
<html lang="en">
{{ >_head }}

<body>
    <div class="container">
        <div class="align-items-center">
            <div class="row mt-4">
                <div class="lead pb-2 col-md-6 col-sm-12 text-right">
                    Editace záznamu <span class="text-secondary">{{ content.params.id }}</span></span>
                </div>
                <div class="pb-2 col-md-6 col-sm-12 text-md-end text-sm-start">
                    <a class="btn btn-sm btn-secondary" href="/admin/training/{{content.params.id}}"><i class="bi bi-door-closed"></i> Zpět na
                        detail</a>
                </div>
            </div>
            {{#content.edited}}
            <div class="row text-center mt-5">
                <div class="col-12">
                    <div class="alert alert-success" role="alert">
                        Trénink byl úspěšně upraven.
                    </div>
                    <div class="col-12">
                    </div>
                    {{/content.edited}}
                    {{^content.edited}}
                    <div class="row text-center mt-5">
                        <div class="col-12">
                            <div class="alert alert-warning" role="alert">
                                Trénink se nepodařilo upravit.
                            </div>
                        </div>
                    </div>
                    {{/content.edited}}
                </div>
            </div>
</body>

</html>